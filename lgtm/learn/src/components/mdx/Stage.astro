---
// <Stage title="..." kicker="...">One line.</Stage> inside <Flow>. The last stage is the highlighted one.
interface Props {
  title: string;
  kicker?: string;
}
const { title, kicker = '' } = Astro.props;
---
<div class="stage">
  <span class="stage-k mono">{kicker}</span>
  <b class="stage-title">{title}</b>
  <slot />
  <svg class="flow-arrow" viewBox="0 0 36 12" preserveAspectRatio="none" aria-hidden="true"><path d="M0 6h30M26 1l6 5-6 5" fill="none" stroke="currentColor" stroke-width="2" /></svg>
</div>
