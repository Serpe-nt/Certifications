---
// <Trap>: the usual mistake. <Trap practice> belongs to the lab work and shows on the Practice tab.
interface Props {
  practice?: boolean;
}
const { practice = false } = Astro.props;
---
<section class="part part-trap" data-block="trap" data-practice={practice ? '' : undefined}>
  <p class="part-label mono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20"/><rect x="3" y="3" width="18" height="18"/></svg>The trap</p>
  <div class="part-body"><slot /></div>
</section>
