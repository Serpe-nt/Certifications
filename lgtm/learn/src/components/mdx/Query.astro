---
// A query to copy. Braces are JavaScript in MDX, so write the query as a string:
// <Query lang="promql">{`sum by (job) (rate(http_requests_total{job="shop"}[5m]))`}</Query>
interface Props {
  lang: 'promql' | 'logql' | 'traceql';
}
const { lang } = Astro.props;
const names = { promql: 'PromQL', logql: 'LogQL', traceql: 'TraceQL' } as const;
---
<div class="codeblock" data-query={lang}>
  <span class="codeblock-label mono">{names[lang] ?? lang}</span>
  <pre><code><slot /></code></pre>
  <button type="button" class="codeblock-copy mono" data-copy>Copy</button>
</div>
