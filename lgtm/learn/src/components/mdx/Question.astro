---
// <Question id="q-m04-s07" answer="b"> The card's knowledge check.
// Inside: the question, then a list of four options. Each list item holds the option,
// a blank line, and its explanation indented under it (see lgtm/learn/README.md).
// Options are shown in a shuffled order, so the letters in `answer` only name list positions.
import CardQuestion from '../islands/CardQuestion.tsx';
import { splitRenderedQuestion } from '../../lib/question-html.ts';

interface Props {
  id: string;
  answer: string;
}
const { id, answer } = Astro.props;
const html = await Astro.slots.render('default');
const { stem, options } = splitRenderedQuestion(html);
const answerIndex = 'abcde'.indexOf(answer);
---
<section class="part box" data-block="question">
  <p class="part-label mono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.7.3-1 .9-1 1.7M12 17v.5"/></svg>Check yourself</p>
  <CardQuestion client:visible id={id} stemHtml={stem} options={options} answer={answerIndex} />
</section>
