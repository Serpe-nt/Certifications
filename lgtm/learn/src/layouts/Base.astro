---
import '../styles/global.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- Applies a forced theme before the first paint. Its hash is allowed by the server's CSP. -->
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('lgtm-learn-v1') || 'null');
        var t = s && s.settings && s.settings.theme;
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-page text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:m-2 focus:p-2 focus:bg-surface">Skip to the content</a>
    <header class="border-b border-line bg-surface">
      <nav class="mx-auto flex max-w-measure items-center justify-between gap-4 px-4 py-3" aria-label="Site">
        <a href={base} class="font-semibold text-ink no-underline">LGTM course</a>
        <span class="flex items-center gap-4">
          <span id="sync-status" class="text-sm text-ink-3" aria-live="polite"></span>
          <a href={`${base}settings/`} class="text-ink-2">Settings</a>
        </span>
      </nav>
    </header>
    <main id="main" class="mx-auto max-w-measure px-4 py-6">
      <slot />
    </main>
    <script>
      import { boot } from '../lib/page.ts';
      boot();
    </script>
  </body>
</html>
