---
import '../styles/global.css';
import Settings from '../components/islands/Settings.tsx';
import Practice from '../components/islands/Practice.tsx';

interface Props {
  title: string;
  /** The page lays out its own header and screen (the step page). Other pages get their PageHead in the
      "head" slot, then one screen around their content. */
  bare?: boolean;
  /** Settings and Practice open as dialogs over the page; their own pages turn this off. */
  dialogs?: boolean;
}
const { title, bare = false, dialogs = true } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#5e6367" />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <!-- Calms the page before the first paint when Effects is off in Settings. Its hash is allowed by the server's CSP. -->
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('lgtm-learn-v1') || 'null');
        if (s && s.settings && s.settings.effects === false) document.documentElement.setAttribute('data-motion', 'off');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-10 focus:m-2 focus:bg-paper focus:p-2">Skip to the content</a>
    <div class="rail rail-l" aria-hidden="true"></div>
    <div class="rail rail-r" aria-hidden="true"></div>
    <div class="console">
      <div class="notch" aria-hidden="true"></div>
      <header class="topbar">
        <a href={base} class="brand">LGTM // LAB</a>
        <nav class="topnav mono" aria-label="Site">
          <span id="sync-status" class="sync" aria-live="polite"></span>
          <a class="navbtn" href={`${base}practice/`} data-dialog="practice">Practice</a>
          <a class="navbtn" href={`${base}settings/`} data-dialog="settings">Settings</a>
        </nav>
      </header>
      <main id="main">
        {
          bare ? (
            <slot />
          ) : (
            <>
            <slot name="head" />
            <div class="screen">
              <div class="glass page-glass">
                <slot />
              </div>
            </div>
            </>
          )
        }
      </main>
    </div>
    {
      dialogs && (
        <>
          <dialog class="modal" data-dialog-name="practice" aria-labelledby="dlg-practice-title">
            <div class="screen modal-screen">
              <div class="glass">
                <div class="modal-head">
                  <h2 id="dlg-practice-title" class="modal-title">Practice</h2>
                  <button type="button" class="closebtn" data-dialog-close aria-label="Close" title="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="3.5"/></svg></button>
                </div>
                <Practice client:visible />
              </div>
            </div>
          </dialog>
          <dialog class="modal" data-dialog-name="settings" aria-labelledby="dlg-settings-title">
            <div class="screen modal-screen">
              <div class="glass">
                <div class="modal-head">
                  <h2 id="dlg-settings-title" class="modal-title">Settings</h2>
                  <button type="button" class="closebtn" data-dialog-close aria-label="Close" title="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4l16 16M20 4 4 20" stroke="currentColor" stroke-width="3.5"/></svg></button>
                </div>
                <Settings client:visible />
              </div>
            </div>
          </dialog>
        </>
      )
    }
    <!-- Motion (src/styles/motion.css, src/lib/fx-ui.ts): the scroll gauge and the pointer's crosshair. -->
    <div class="scroll-gauge" aria-hidden="true"></div>
    <div class="reticle" aria-hidden="true"><span class="reticle-dot"></span><span class="reticle-xy mono"></span></div>
    <script>
      import { boot } from '../lib/page.ts';
      boot();
    </script>
  </body>
</html>
