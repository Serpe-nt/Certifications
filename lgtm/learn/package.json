{
  "name": "lgtm-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Study site for the LGTM observability course: Astro pages, React islands, a small Node server with SQLite.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev --port 8095",
    "dev:sample": "cross-env ASTRO_TELEMETRY_DISABLED=1 LGTM_CONTENT=sample astro dev --port 8095",
    "build": "node scripts/check-content.ts && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:sample": "cross-env LGTM_CONTENT=sample LGTM_OUT=dist-sample node scripts/check-content.ts && cross-env LGTM_CONTENT=sample LGTM_OUT=dist-sample ASTRO_TELEMETRY_DISABLED=1 astro build",
    "start": "node server/main.mjs",
    "check:content": "node scripts/check-content.ts",
    "check:links": "node scripts/check-links.ts",
    "check:types": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "setup:browsers": "cross-env PLAYWRIGHT_BROWSERS_PATH=.bin/ms-playwright playwright install chromium-headless-shell",
    "test": "npm run test:unit && npm run check:types && npm run build:sample && npm run test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.3",
    "@astrojs/react": "7.1.5",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro": "7.4.8",
    "cross-env": "10.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
