# Settings for compose.yaml (build and smoke test only). Values that differ
# per run, such as DEMO_VERSION, are passed in by the Makefile.

# Images
IMAGE_NAME=ghcr.io/serpe-nt/lgtm-demo
DEMO_VERSION=3.1.0-lab.1

# Build arguments, as at upstream tag 3.1.0
OTEL_JAVA_AGENT_VERSION=2.31.1

# Third-party images, pinned as at upstream tag 3.1.0 (busybox added for the flag volume)
COLLECTOR_CONTRIB_IMAGE=ghcr.io/open-telemetry/opentelemetry-collector-releases/opentelemetry-collector-contrib:0.159.0@sha256:1f2c54a30e713fac6b3ae77a1ec84010c2007e29ced8ec666214fc2f6739c1cc
FLAGD_IMAGE=ghcr.io/open-feature/flagd:v0.16.0
POSTGRES_IMAGE=postgres:18.4
VALKEY_IMAGE=ghcr.io/valkey-io/valkey:9.0.4-alpine3.23
BUSYBOX_IMAGE=busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec

# The only host port: the shop's front door (frontend-proxy). The lab's test
# ports are 8095 to 8098.
SHOP_PORT=8098

# Resource attributes every service reports
OTEL_SERVICE_NAMESPACE=opentelemetry-demo
OTEL_RESOURCE_ATTRIBUTES=service.namespace=opentelemetry-demo,service.version=3.1.0-lab.1

# Service ports inside the Compose network
AD_PORT=9555
AD_PROMETHEUS_PORT=9465
CART_PORT=7070
CHECKOUT_PORT=5050
ENVOY_PORT=8080
ENVOY_ADMIN_PORT=10000
FRONTEND_PORT=8080
IMAGE_PROVIDER_PORT=8081
LOCUST_WEB_PORT=8089
LOCUST_USERS=5
PAYMENT_PORT=50051
PRODUCT_CATALOG_PORT=3550
RECOMMENDATION_PORT=9001
FLAGD_PORT=8013
FLAGD_OFREP_PORT=8016
FLAGD_UI_PORT=4000

# PostgreSQL. These are the fixed demo passwords from src/postgresql/init.sql,
# public upstream and used only inside the throwaway test network.
POSTGRES_PASSWORD=changeit
POSTGRES_ASTRONOMY_PASSWORD=astronomy_password
