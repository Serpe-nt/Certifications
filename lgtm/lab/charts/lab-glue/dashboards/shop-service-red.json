{
  "title": "Shop / __SERVICE__ (RED)",
  "uid": "shop-red-__SERVICE__",
  "description": "Rate, errors and duration of __SERVICE__ from Tempo's span metrics (Mimir, tenant lab), with exemplars that open the trace, and the service's logs from Loki.",
  "tags": ["shop", "red", "lab"],
  "timezone": "browser",
  "schemaVersion": 41,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "span_kind",
        "label": "Span kind",
        "type": "custom",
        "query": "SPAN_KIND_SERVER,SPAN_KIND_CONSUMER,SPAN_KIND_CLIENT,SPAN_KIND_PRODUCER,SPAN_KIND_INTERNAL",
        "multi": true,
        "includeAll": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Rate (requests per second, by span name)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Errors (share of spans with status error)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "sum(rate(traces_spanmetrics_calls_total{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) / sum(rate(traces_spanmetrics_calls_total{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\"}[$__rate_interval]))",
          "legendFormat": "error ratio"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Duration (p50, p95, p99), with exemplars",
      "description": "The dots are exemplars: each one carries the trace id of a real request. Hover one and choose the link to open the trace in Tempo.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "mimir" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "mimir" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traces_spanmetrics_latency_bucket{service_name=\"__SERVICE__\", span_kind=~\"$span_kind\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Logs of __SERVICE__",
      "description": "Lines that carry a trace id show an Open trace link.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 17 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": { "showTime": true, "wrapLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{service_name=\"__SERVICE__\"}"
        }
      ]
    }
  ]
}
