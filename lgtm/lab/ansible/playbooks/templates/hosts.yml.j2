{% set lab = inventory_lab %}
{% set portproxy = (lab.network.control_access | default('direct')) == 'portproxy' %}
{% set lb = (lab.nodes | selectattr('role', 'equalto', 'lb') | list)[0] %}
{% set ssh_args = '-o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=~/.ssh/known_hosts_' ~ lab.lab.cluster_name %}
---
# Generated by `make inventory` from lgtm/lab/vm/nodes.yml. Do not edit by hand:
# change nodes.yml and run `make inventory` again.
all:
  vars:
    ansible_user: {{ lab.ssh.user }}
    ansible_ssh_private_key_file: {{ lab.ssh.private_key_file }}
    # Host keys of the lab VMs go to their own known_hosts file, accepted on first contact.
    ansible_ssh_common_args: "{{ ssh_args }}"
    ssh_allowed_users: {{ lab.ssh.user }}
    lab_cluster_name: {{ lab.lab.cluster_name }}
    lab_upstream_dns:
{% for server in lab.network.upstream_dns %}
      - {{ server }}
{% endfor %}
    dns_server_ip: {{ lab.network.lab_dns }}
    dns_search_domain: {{ lab.network.domain }}
    # cloud-init already configured the single network card.
    network_manage_k8s_interface: false
    master_init_apiserver_cert_extra_sans:
      - {{ lb.address }}
{% if portproxy %}
      - 127.0.0.1
    kubeconfig_fetch_server: https://127.0.0.1:6443
{% endif %}
  children:
    load_balancer:
      hosts:
        {{ lb.name }}:
          ansible_host: {{ '127.0.0.1' if portproxy else lb.address }}
{% if portproxy %}
          ansible_port: {{ lab.network.portproxy_ssh_base + (lb.address.split('.')[3] | int) }}
{% endif %}
          k8s_net_ip: {{ lb.address }}
    k8s_cluster:
      children:
{% for group, role in [('control_plane', 'control_plane'), ('workers', 'worker')] %}
        {{ group }}:
          hosts:
{% for node in lab.nodes | selectattr('role', 'equalto', role) %}
            {{ node.name }}:
              ansible_host: {{ '127.0.0.1' if portproxy else node.address }}
{% if portproxy %}
              ansible_port: {{ lab.network.portproxy_ssh_base + (node.address.split('.')[3] | int) }}
{% endif %}
              k8s_net_ip: {{ node.address }}
              k8s_interface: {{ lab.network.interface }}
{% if node.data_disk_gb is defined %}
              node_prereqs_data_disk_size_gb: {{ node.data_disk_gb }}
{% endif %}
{% endfor %}
{% if role == 'worker' %}
          vars:
            node_prereqs_longhorn: true
{% endif %}
{% endfor %}
