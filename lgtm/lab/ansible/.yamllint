---
# yamllint settings for the lab cluster files (ansible/, vm/nodes.yml, the CI workflow).
# They follow what ansible-lint expects from yamllint.
extends: default
ignore: |
  **/.ansible/
  # Test stubs generated by ansible-galaxy in the copied roles; ansible-lint skips them too.
  **/roles/*/tests/
rules:
  line-length:
    max: 160
    # Copied unchanged from k8s-provision: one long raw command.
    ignore: |
      **/playbooks/nopass_sudo.yml
  document-start:
    # Copied unchanged from k8s-provision.
    ignore: |
      **/inventory/examples/kvm-multi-nic/hosts.yml
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
