# {{ ansible_managed }}
# Rendered by the lb_haproxy role from the owner's haproxy.cfg; servers come from the inventory groups.
#---------------------------------------------------------------------
# Global settings
#---------------------------------------------------------------------
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin expose-fd listeners
    stats timeout 30s
    user haproxy
    group haproxy
    daemon

    # Default SSL material location
    ca-base /etc/ssl/certs
    crt-base /etc/ssl/private

    ssl-default-bind-ciphersuites TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256
    ssl-default-bind-options ssl-min-ver TLSv1.2 no-tls-tickets
    tune.ssl.default-dh-param 2048
    maxconn 4096

#---------------------------------------------------------------------
# Defaults
#---------------------------------------------------------------------
defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    option  redispatch
    timeout connect 5s
    timeout client  50s
    timeout server  50s
    timeout check   5s
    retries 3
    default-server inter 10s downinter 5s fall 3 rise 2 slowstart 60s
    errorfile 400 /etc/haproxy/errors/400.http
    errorfile 403 /etc/haproxy/errors/403.http
    errorfile 408 /etc/haproxy/errors/408.http
    errorfile 500 /etc/haproxy/errors/500.http
    errorfile 502 /etc/haproxy/errors/502.http
    errorfile 503 /etc/haproxy/errors/503.http
    errorfile 504 /etc/haproxy/errors/504.http

#---------------------------------------------------------------------
# Stats / monitoring
#---------------------------------------------------------------------
frontend stats
    mode http
    bind *:8404
    option httplog
    stats enable
    stats uri /stats
    stats refresh 10s
    stats show-legends
    stats show-node
    stats admin if LOCALHOST
    monitor-uri /healthz

#---------------------------------------------------------------------
# Kubernetes API Server - TCP passthrough (6443)
#---------------------------------------------------------------------
frontend k8s_api
    bind *:6443
    option tcplog
    default_backend k8s_api_servers

backend k8s_api_servers
    balance roundrobin
    option httpchk GET /healthz
    http-check expect status 200
    default-server check check-ssl verify none inter 10s downinter 5s fall 3 rise 2
{% for host in groups[lb_haproxy_control_plane_group] %}
    server {{ host }} {{ hostvars[host].k8s_net_ip }}:6443
{% endfor %}

#---------------------------------------------------------------------
# Ingress HTTP - TCP passthrough (80 -> NodePort {{ lb_haproxy_http_node_port }})
#---------------------------------------------------------------------
frontend ingress_http
    bind *:80
    option tcplog
    default_backend ingress_http_workers

backend ingress_http_workers
    balance roundrobin
{% if lb_haproxy_ingress_http_check %}
    option httpchk GET {{ lb_haproxy_ingress_http_check_path }}
    http-check expect status 200
{% endif %}
    default-server check inter 10s downinter 5s fall 3 rise 2
{% for host in groups[lb_haproxy_worker_group] %}
    server {{ host }} {{ hostvars[host].k8s_net_ip }}:{{ lb_haproxy_http_node_port }}
{% endfor %}

#---------------------------------------------------------------------
# Ingress HTTPS - TCP passthrough (443 -> NodePort {{ lb_haproxy_https_node_port }})
#---------------------------------------------------------------------
frontend ingress_https
    bind *:443
    option tcplog
    default_backend ingress_https_workers

backend ingress_https_workers
    balance roundrobin
{% if lb_haproxy_ingress_http_check %}
    option httpchk GET {{ lb_haproxy_ingress_http_check_path }}
    http-check expect status 200
    default-server check check-ssl verify none inter 10s downinter 5s fall 3 rise 2
{% else %}
    default-server check inter 10s downinter 5s fall 3 rise 2
{% endif %}
{% for host in groups[lb_haproxy_worker_group] %}
    server {{ host }} {{ hostvars[host].k8s_net_ip }}:{{ lb_haproxy_https_node_port }}
{% endfor %}
