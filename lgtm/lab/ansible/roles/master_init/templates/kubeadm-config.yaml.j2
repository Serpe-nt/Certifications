apiVersion: kubeadm.k8s.io/v1beta4
kind: ClusterConfiguration
controlPlaneEndpoint: "{{ control_plane_endpoint }}:6443"
networking:
  podSubnet: "{{ pod_network_cidr }}"
  serviceSubnet: "{{ master_init_service_network_cidr }}"
{% if master_init_apiserver_cert_extra_sans | length > 0 %}
apiServer:
  certSANs:
{% for san in master_init_apiserver_cert_extra_sans %}
    - "{{ san }}"
{% endfor %}
{% endif %}
controllerManager:
  extraArgs:
    - name: allocate-node-cidrs
      value: "false"
---
apiVersion: kubeadm.k8s.io/v1beta4
kind: InitConfiguration
localAPIEndpoint:
  advertiseAddress: "{{ k8s_net_ip }}"
nodeRegistration:
  kubeletExtraArgs:
    - name: node-ip
      value: "{{ k8s_net_ip }}"