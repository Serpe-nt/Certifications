---
# The RustFS screen at http://s3.{{ lab_domain }} (lab contract: addresses in the browser).
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: rustfs-console
  namespace: {{ platform_s3_namespace }}
spec:
  parentRefs:
    - name: {{ platform_gateway_name | default('lab') }}
      namespace: {{ platform_gateway_namespace | default('gateway') }}
  hostnames:
    - s3.{{ lab_domain }}
  rules:
    - backendRefs:
        - name: {{ platform_s3_service }}
          port: 9001
