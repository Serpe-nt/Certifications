# Where the lab is. Read by run.py and by compose.yaml; the lessons explain
# each line. Values you set in your own environment win over these.
#
# OTLP over HTTP into the lab's collector gateway, through the lab gateway's
# "otlp" address (lab contract, Addresses in the browser).
OTEL_EXPORTER_OTLP_ENDPOINT=http://otlp.lab.k8s.local
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Who is sending.
OTEL_SERVICE_NAME=workshop
OTEL_RESOURCE_ATTRIBUTES=service.namespace=workshop,deployment.environment.name=learner-pc
# The shop the service calls.
SHOP_URL=http://shop.lab.k8s.local
