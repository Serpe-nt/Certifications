# 05 correlated logs (module m08): the logging instrumentation attaches an
# OpenTelemetry handler to Python's root logger, so every log record is also
# sent over OTLP with the trace id and span id of the span it was written in.
WORKSHOP_COMMAND=opentelemetry-instrument python app.py
# The current, stable semantic conventions for HTTP and databases (the
# instrumentations still default to the old attribute names).
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=requests
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_LOGS_EXPORTER=otlp
# Also print the trace id and span id in the lines on standard output.
OTEL_PYTHON_LOG_CORRELATION=true
