# 03 context propagation to the shop (module m07): the requests
# instrumentation is switched off, and app.py injects the W3C trace context
# and baggage into its calls to the shop by hand. The trace continues in the
# shop's frontend-proxy and frontend.
WORKSHOP_COMMAND=opentelemetry-instrument python app.py
# The current, stable semantic conventions for HTTP and databases (the
# instrumentations still default to the old attribute names).
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=requests
# W3C Trace Context and W3C Baggage (the default, written out).
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
