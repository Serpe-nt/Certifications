# 01 zero-code instrumentation (module m07): app.py is unchanged; the agent
# instruments Flask, requests and sqlite3 when the service starts.
WORKSHOP_COMMAND=opentelemetry-instrument python app.py
# The current, stable semantic conventions for HTTP and databases (the
# instrumentations still default to the old attribute names).
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
# Traces only for now. Metrics start in 04, logs in 05.
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
