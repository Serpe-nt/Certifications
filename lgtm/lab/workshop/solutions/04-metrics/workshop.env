# 04 metrics (module m08): app.py records its own metrics with the meter API;
# the metrics exporter is switched on. The Flask instrumentation adds the
# HTTP server duration histogram.
WORKSHOP_COMMAND=opentelemetry-instrument python app.py
# The current, stable semantic conventions for HTTP and databases (the
# instrumentations still default to the old attribute names).
OTEL_SEMCONV_STABILITY_OPT_IN=http,database
OTEL_PYTHON_DISABLED_INSTRUMENTATIONS=requests
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
# Export every 15 seconds instead of every 60, so a change shows quickly.
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_LOGS_EXPORTER=none
